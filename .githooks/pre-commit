#!/bin/sh
# Pre-commit: auto-build dist before every commit
echo "[NE] pre-commit: npm run build..."
npm run build
if [ $? -ne 0 ]; then
    echo "[NE] Build failed, commit aborted."
    exit 1
fi
# Stage dist/index.js if it changed (build may update it)
git add dist/index.js src/core/test-runner/test-data.generated.js
echo "[NE] pre-commit: OK"
