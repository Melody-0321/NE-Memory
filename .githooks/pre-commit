#!/bin/sh
# Pre-commit: auto-build dist before every commit
# Use dev build (non-stripped) so hash versions loaded from CDN have diagnostics content.
# Release commits should use --no-verify to preserve the prod build from `npm run build:all`.
echo "[NE] pre-commit: npm run build:dev:all..."
if ! npm run build:dev:all; then
    echo "[NE] Build failed, commit aborted."
    exit 1
fi

echo "[NE] pre-commit: npm run build:readme..."
if ! npm run build:readme; then
    echo "[NE] README.html build failed, commit aborted."
    exit 1
fi

echo "[NE] pre-commit: npm run build:doc-index..."
if ! npm run build:doc-index; then
    echo "[NE] Doc index build failed, commit aborted."
    exit 1
fi

# Stage built artifacts if they changed
git add dist/index.js src/core/test-runner/test-data.generated.js README.html .trae/documents/INDEX.md PLAN_INDEX.md

echo "[NE] pre-commit: OK"
exit 0
