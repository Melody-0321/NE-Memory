      "state": {
        "characters": {
          "江岚": {
            "gender_age": "男, 大学二年级, 约19-20岁",
            "physique": "肩部宽于骨盆, 体脂率低, 腹直肌轮廓可见",
            "occupation": "大学二年级学生 / 网络小说作者",
            "personality": "沉静、内敛、自律, 说话简洁有主见",
            "clothing_build": "",
            "injuries": "",
            "status_effects": "",
            "past_experience": "与安然为异性同位体, 世界线融合后共同生活, 现合租公寓",
            "inventory": "",
            "name": "江岚",
            "status": "活跃",
            "_role": "protagonist",
            "current_mood": "意外。他没想到自己会主动提起这件事，更没想到安然会问那三个人的名字",
            "inner_thoughts": "她问名字干什么？都过去这么多年了，难不成还想去找人算账。不过提起卡大纲的事，她倒是一针见血。我自己稿子卡哪了——其实也没那么复杂，就是主角面临的那个选择，和我自己经历过的事太像，写不下去。"
          },
          "安然": {
            "status": "活跃",
            "current_mood": "被江岚提起的陈年往事触动，想问清楚但又不想显得太在意，于是用稿子的事转移话题",
            "relationship": "",
            "gender_age": "女, 大学二年级, 约19-20岁",
            "physique": "身高约170cm, 黑色短发, 假小子风格, 有腹肌线条",
            "occupation": "大学二年级学生 / 网络小说作者",
            "clothing_build": "",
            "personality": "外在帅气直率, 独立自主, 略带挑衅与幽默",
            "past_experience": "与江岚为异性同位体, 世界线融合后共同生活, 现合租公寓",
            "inner_thoughts": "他在那栋楼下被揍的时候我在哪？哦，那时候我还没搬过来。不对，就算搬过来了，我也不会管——那时候我们又不认识。但现在我想管了。那些人是哪个班的？妈的，过了这么多年，问了也白问。还是说稿子吧，问他大纲卡哪了，他总愿意答的。",
            "affection": null,
