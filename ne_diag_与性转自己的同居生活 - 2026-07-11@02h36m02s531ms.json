      "unconsolidated_stm": [
        {
          "event": "江岚拒绝安然征用充电线，从安然口袋抽出钥匙开门让安然进屋；安然反驳后强征充电线，坐入沙发充电。",
          "period": "2024-05-21 21:41",
          "scene": "702公寓客厅",
          "msg_ids": [
            "11_2026-07-10T18:50:57.191Z_user",
            "12_2026-07-10T18:50:58.012Z_assistant"
          ],
          "absMsgStart": 11,
          "absMsgEnd": 12,
          "msgRange": [
            11,
            12
          ],
          "status": "closed",
          "entities": [
            "江岚",
            "安然"
          ],
          "_inner_thoughts": {
            "江岚": [
              "她在耍赖，而且她知道自己在耍赖。不过编辑十一点要对大纲这事是真的——昨天听她提过一嘴。我的闹钟明早七点，如果十一点前她把线还我，充到明早刚好够用。但前提是她真的会还。先不管了，等会儿直接在沙发上拔掉就行。"
            ],
            "安然": [
              "他肯定要说我又耍赖了。但管他呢，先充上再说。编辑那个大纲今晚不对完明天又要催，我手机要是自动关机了，他替我挨骂吗？螺丝刀我会去拿的，插座我自己修也不是不行——不过他那条充电线今晚就先归我了。"
            ]
          },
          "id": "stm_7"
        }
      ],
      "stm_entries": [
        {
          "event": "傍晚七点，江岚健身回家发现公寓被短发女孩安然占据。两人争执后冷静下来，发现彼此租房合同和身份证信息几乎完全一致，意识到可能发生了平行世界融合或性转现象。江岚和安然核对生活细节后确认对方就是性转版本的自己。两人在阳台吸烟交谈后，决定同住。",
          "period": "2024-05-21 21:35",
          "scene": "702公寓 · 阳台",
